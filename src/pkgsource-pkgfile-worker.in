#!/bin/sh
# SPDX-FileCopyrightText: 2026 Alexandr Savca
# SPDX-License-Identifier: GPL-3.0-or-later
# Private pkgfile/0 evaluation worker. Its output is an internal protocol.

root=$1
[ -n "$root" ] || exit 64
cd "$root" || exit 65
_libpkgsource_root=$(pwd -P) || exit 65
readonly _libpkgsource_root

unset name version release source
# Pkgfiles are executable shell. Keep incidental standard output out of the
# framed record; diagnostics remain available on the worker's stderr channel.
# shellcheck disable=SC1091
. "$_libpkgsource_root/Pkgfile" 1>&2 || exit 66
# Top-level Pkgfile commands may change directory. Source word expansion is a
# package-source-directory operation, so restore the explicit worker cwd.
cd "$_libpkgsource_root" || exit 65

[ -n "${name:-}" ] || exit 67
[ -n "${version:-}" ] || exit 68
[ -n "${release:-}" ] || exit 69
case $(command -V build 2>/dev/null) in
  *function*) ;;
  *) exit 70 ;;
esac

# Match the legacy protocol's unquoted source iteration after shell evaluation:
# field splitting and pathname expansion are intentional.
# shellcheck disable=SC2086
set -- ${source-}
/usr/bin/printf '%s\0' \
  'pkgsource-pkgfile/0' "$name" "$version" "$release" 'build' "$#"
for source_word do
  /usr/bin/printf '%s\0' "$source_word"
done
