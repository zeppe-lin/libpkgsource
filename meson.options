option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'How libpkgsource links against external dependencies',
)
option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the libpkgsource test suite',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Build manual pages with scdoc',
)
option(
  'planner_adapter',
  type: 'feature',
  value: 'disabled',
  description: 'Build the optional native libpkgplan projection adapter',
)
option(
  'yaml_adapter',
  type: 'feature',
  value: 'disabled',
  description: 'Build the strict recipe.yml/1 and profiles.yml/1 syntax adapter',
)
