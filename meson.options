option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'How libpkgsource links against external dependencies',
)
option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the libpkgsource test suite',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Install generated manual pages',
)

option(
  'sha256_provider',
  type: 'combo',
  choices: ['openssl'],
  value: 'openssl',
  description: 'Qualified SHA-256 implementation provider',
)
